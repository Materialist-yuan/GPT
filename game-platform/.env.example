# Run ./scripts/init-env.sh to generate .env. Never commit .env.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
JWT_SECRET=__JWT_SECRET__
SERVER_ID=s1
GATEWAY_PUBLIC_ADDR=127.0.0.1:9000
LOGIN_BIND_ADDR=127.0.0.1
GATEWAY_BIND_ADDR=127.0.0.1
# Local demo allowance; use 60 or your own policy in a production deployment.
AUTH_RATE_LIMIT=600
GATEWAY_MAX_CONNECTIONS=10000
# Must not exceed the Docker host/daemon's hard limit.
GATEWAY_NOFILE=16384
LOCAL_UID=__LOCAL_UID__
LOCAL_GID=__LOCAL_GID__
